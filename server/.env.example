

PORT=4000
NODE_ENV=development

# MongoDB Atlas (free M0 cluster) or local: mongodb://127.0.0.1:27017/ethixweb
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ethixweb?retryWrites=true&w=majority

# Signs the admin session cookie. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# bcrypt hash of your admin password. Generate with:  npm run hash-password -- "your passphrase"
ADMIN_PASSWORD_HASH='paste-the-generated-hash-here'

# Salt used when hashing visitor IPs stored with leads
IP_HASH_SALT=replace-with-a-random-string

# Number of reverse proxies in front of Express (Render/Railway/Heroku = 1, local = 0)
TRUST_PROXY=0
